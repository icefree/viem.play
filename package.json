{
  "name": "viem.play",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest src",
    "test:integration": "vitest tests/integration",
    "test:ui": "vitest --ui",
